import java.util.Collection;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;

public class TrustLevel {

    private static final Map<String, TrustLevel> REGISTRY = new ConcurrentHashMap<>();

    public static final TrustLevel ACCESS = register("access", 1, "Доступ", "<#A79FC0>");
    public static final TrustLevel CONTAINER = register("container", 2, "Сундуки", "<#FDE68A>");
    public static final TrustLevel BUILD = register("build", 3, "Строитель", "<#86EFAC>");
    public static final TrustLevel MANAGER = register("manager", 4, "Управляющий", "<#FCD34D>");
    public static final TrustLevel OWNER = register("owner", 5, "Владелец", "<#FB7185>");

    private final String id;
    private final int weight;
    private final String defaultName;
    private final String defaultColor;

    public TrustLevel(String id, int weight, String defaultName, String defaultColor) {
        this.id = id.toLowerCase(Locale.ROOT);
        this.weight = weight;
        this.defaultName = defaultName;
        this.defaultColor = defaultColor;
    }

    public static TrustLevel register(String id, int weight, String defaultName, String defaultColor) {
        TrustLevel level = new TrustLevel(id, weight, defaultName, defaultColor);
        REGISTRY.put(level.id, level);
        return level;
    }

    public static void clearCustom() {
        REGISTRY.clear();
        REGISTRY.put(ACCESS.id, ACCESS);
        REGISTRY.put(CONTAINER.id, CONTAINER);
        REGISTRY.put(BUILD.id, BUILD);
        REGISTRY.put(MANAGER.id, MANAGER);
        REGISTRY.put(OWNER.id, OWNER);
    }

    public int weight() {
        return weight;
    }

    public String name() {
        return id.toUpperCase(Locale.ROOT);
    }

    public String displayName() {
        return defaultName;
    }

    public String color() {
        return defaultColor;
    }

    public boolean atLeast(TrustLevel required) {
        if (required == null) return false;
        return weight >= required.weight;
    }

    public String key() {
        return id;
    }

    public static Optional<TrustLevel> parse(String raw) {
        if (raw == null) return Optional.empty();
        return Optional.ofNullable(REGISTRY.get(raw.trim().toLowerCase(Locale.ROOT)));
    }

    public static Collection<TrustLevel> values() {
        return REGISTRY.values();
    }

    public static TrustLevel[] grantable() {
        return REGISTRY.values().stream()
                .filter(l -> l.weight < OWNER.weight)
                .toArray(TrustLevel[]::new);
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj) return true;
        if (!(obj instanceof TrustLevel other)) return false;
        return id.equals(other.id);
    }

    @Override
    public int hashCode() {
        return id.hashCode();
    }
}
